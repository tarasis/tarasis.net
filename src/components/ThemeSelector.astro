	h1,
	p {
		color: var(--bg);
		line-height: 2;
		max-width: 60ch;
		padding-left: 2rem;
	}

	a {
		color: #011427;
		color: var(--text);

		background: #accdd7;
		background: var(--btn);

		outline: dotted 1px #011427;
		outline: dotted 1px var(--text);
		outline-offset: 0;
		text-decoration: none;
	}

	a:hover {
		outline-style: solid;
	}
